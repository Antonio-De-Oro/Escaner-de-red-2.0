# Clave de API de Google AI Studio para habilitar VulneraBot (Gemini 3.1 Flash Lite)
# Si se deja vacío, la aplicación inicia con normalidad usando respuestas locales de contingencia.
GEMINI_API_KEY=tu_clave_de_google_gemini_aqui
